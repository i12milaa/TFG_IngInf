@startuml
allowmixing

title Diagrama de módulos — Servidor Central Python

left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 90

class "server_central.py\nArbitroServer" as Arbitro <<module>> {
  --
  -clients: dict[socket, int]
  -client_sockets: dict[int, socket]
  -client_buffers: dict[socket, bytes]
  -track_states: dict[int, dict]
  -latest_reports: dict[int, dict]
  -reports_received: set
  -track_lock: dict[int, int]
  -strikes: dict[int, int]
  -grace_until_sf: dict[int, int]
  -requests: dict[int, bool]
  -seq: int
  -current_phase: int
  -running: bool
  -lock: Lock
  -grid: dict
  --
  +start()
  +handle_client()
  +remove_client()
  +get_state()
}

class "OrquestadorSuperframe" as Orquestador <<module>> {
  --
  -SWEEP_ANGLE_TOTAL = 90.0°
  -A_MAX = 45.0°
  -A_MIN = -45.0°
  -TRACK_LOCK_DURATION = 6
  -MAX_MISSES = 3
  -DIRTY_MARGIN = 30.0°
  -STEP_ANGLE = 2.5°
  -TRILAT_MAX_DIST_RATIO = 2.0
  --
  +orchestration_loop()
  +calculate_movement_time()
}

class "LocalizadorCooperativo" as Localizador <<module>> {
  --
  -defcon1_limit: float
  -defcon2_limit: float
  -defcon3_limit: float
  -valla_limit: float
  --
  +calculate_global_coords()
  +calcular_trilateracion()
}

class "GestorPersistencia" as Persistencia <<module>> {
  --
  -CONFIG_FILE: str
  -STATE_FILE: str
  -VIZ_SETTINGS: str
  --
  +load_grid()
  +save_grid()
  +load_state()
  +save_state()
}

class "comms_protocol\nProtocolo TCP" as Protocol <<module>> {
  --
  +MSG_HELLO_REQ = 0xA0
  +MSG_HELLO_ACK = 0xA1
  +MSG_SUPERFRAME_START = 0xB0
  +MSG_SLOT_ASSIGN = 0xB1
  +MSG_REPORT_REQ = 0xB2
  +MSG_ANGLE_REQ = 0xC0
  +MSG_DATA_REPORT = 0xD0
  --
  +PacketHeader
  +Payload_HelloReq / HelloAck
  +Payload_SuperFrame
  +Payload_SlotAssign
  +Payload_DataReport
}

class "grid_config.json\nPosiciones radar" as GridJson <<external>> {
  --
  -mac: str
  -id: int
  -x, y: float
  -theta: float
}

class "radar_state.json\nEstado persistente" as StateJson <<external>> {
  --
  -mode: str
  -current_angle: float
  -misses: int
  -edge_flips: int
  -track_entry_sf: int
}

class "Visualizador\nradar_visualizer:8081" as Viz <<external>> {
  --
  -seq: int
  -radars: dict
  -hits: dict
  -trilat: dict
}

class "Nodos ESP32\nradar-server:8080" as Nodes <<external>> {
  --
  +N1 (id=1)
  +N2 (id=2)
  +N3 (id=3)
}

' --- Estructura visual fija ---
Persistencia -[hidden]down- Protocol
Orquestador -[hidden]down- Localizador
GridJson -[hidden]down- StateJson

' --- Dependencias reales ---
Arbitro --> Orquestador
Arbitro --> Localizador
Arbitro --> Persistencia
Arbitro --> Protocol

Orquestador --> Protocol

Persistencia --> GridJson
Persistencia --> StateJson

Arbitro --> Viz : JSON / UDP:8081
Nodes --> Arbitro : TCP:8080
Arbitro --> Nodes : TCP:8080

@enduml
